# AgriSaathi Unified Platform Environment Variables
FLASK_ENV=development
SECRET_KEY=agrisaathi-unified-dev-secret-key-2026
PORT=5000

# Database Configuration (MySQL)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=agrisaathi_db
DATABASE_USER=root
DATABASE_PASSWORD=

# Set to 'true' to use SQLite fallback if local MySQL is offline during prototyping
USE_SQLITE_FALLBACK=true

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

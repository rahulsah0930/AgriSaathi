# ==============================================================================
# AgriSaathi Platform Environment Configuration Template
# For production deployment, set actual values in your host provider's environment.
# NEVER commit production secrets or credentials to source control.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
FLASK_ENV=development
PORT=5000

# Security & Authentication (Required: Generate strong random secrets in production)
# e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=86400

# Database Configuration
# Production: Provide PostgreSQL connection string (Neon, Supabase, AWS RDS, Render, etc.)
# e.g. postgresql://user:password@hostname:5432/agrisaathi_prod
DATABASE_URL=
# Local Development SQLite fallback (only active when APP_ENV=development and DATABASE_URL is empty)
USE_SQLITE_FALLBACK=true

# Seeding & Demo Mode
# In production, DEMO_MODE defaults to false (preventing predictable demo users from being seeded)
DEMO_MODE=false

# File Storage Provider (local | cloudinary)
# Local: Files saved to backend/uploads/ (suitable for local testing)
# Cloudinary: Production cloud object storage for crop, POD, and commodity images
STORAGE_PROVIDER=local

# Cloudinary Cloud Object Storage Credentials (Required if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload Limitations
MAX_CONTENT_LENGTH=10485760

# Frontend Cross-Origin Resource Sharing (CORS) Configuration
# In production, set to your production frontend domain (e.g. https://agrisaathi.vercel.app)
# Comma-separated list for multiple origins. No wildcard '*' in production.
FRONTEND_URL=http://localhost:5173
